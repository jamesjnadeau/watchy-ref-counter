    footprint = "footprints:24_Pins_0.5mm_Pitch_ZIF_Connector_UP"
    package = "FPC24-0.5mm"
    mpn = "FPC24(0.5MM)"
    value = "FPC24(0.5MM)"
    description = "FPC24 0.5mm ZIF"
    pin 1
    pin 2
    pin 3
    pin 4
    pin 5
    pin 6
    pin 7
    pin 8
    pin 9
    pin 10
    pin 11
    pin 12
    pin 13
    pin 14
    pin 15
    pin 16
    pin 17
    pin 18
    pin 19
    pin 20
    pin 21
    pin 22
    pin 23
    pin 24
    pin "M"

component J_Battery:
    designator_prefix = "J"
    footprint = "footprints:1.25T-2PWT (Molex 532610271)"
    package = "1.25mm-2P"
